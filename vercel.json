{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/about-5", "destination": "/about", "permanent": true },
    { "source": "/services-4", "destination": "/ai-pr-agency", "permanent": true },
    { "source": "/s-projects-basic", "destination": "/work", "permanent": true }
